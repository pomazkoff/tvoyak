# Локальный Supabase после `supabase start`.
# Ключи берите из `supabase status -o env`: ANON_KEY и SERVICE_ROLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Проверка спорных ответов через OpenRouter. Дешёвая модель, например google/gemini-2.5-flash.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Пока не true и не 1, маршрут /api/answer-check модель не вызывает.
ANSWER_CHECK_USE_LLM=false
