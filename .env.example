# Локальный Supabase после `supabase start`.
# Ключи берите из `supabase status -o env`: ANON_KEY и SERVICE_ROLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Необязательно: адрес Supabase для браузера, если он отличается от SUPABASE_URL
# (например, https://db.tvoyak.ru — свой прокси для доступа из России).
# Встраивается в клиентский бандл при сборке: после смены нужен новый деплой.
NEXT_PUBLIC_SUPABASE_URL=

# Проверка спорных ответов через OpenRouter. Дешёвая модель, например google/gemini-2.5-flash.
OPENROUTER_API_KEY=
# Необязательно: запасной ключ, если основной отозван (401/402/403)
OPENROUTER_API_KEY_FALLBACK=
OPENROUTER_MODEL=

# Пока не true и не 1, маршрут /api/answer-check модель не вызывает.
ANSWER_CHECK_USE_LLM=false

# Страница /admin и ручной запуск сборки пачки. Без этого /admin только пишет, что токена нет.
ADMIN_TOKEN=

# Необязательно. Vercel Cron шлёт его как Authorization: Bearer. Если пусто, для cron годится ADMIN_TOKEN.
CRON_SECRET=
# Необязательно. Пускает только на /admin/pictures (ревью картиночных заданий).
ADMIN_REVIEW_TOKEN=

# Необязательно. Общий секрет с обратным прокси (nginx на VPS): с ним сервер
# верит заголовку X-Edge-Client-IP (настоящий IP игрока) для лимитов.
EDGE_PROXY_SECRET=
